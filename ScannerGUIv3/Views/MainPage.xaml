<Page
   x:Class="ScannerGUIv3.Views.MainPage"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   xmlns:local="using:ScannerGUIv3"
   mc:Ignorable="d">

   <Grid x:Name="ContentArea" Margin="20">
       <Grid.RowDefinitions>
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" /> <!-- Debug Buttons -->
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

       <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto" />
           <ColumnDefinition Width="Auto" />
           <ColumnDefinition Width="Auto" />
           <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>

       <!-- Personnel Number TextBox spanning two columns -->
       <TextBox x:Name="PersonnelNumberTextBox" 
                PlaceholderText="Personnel Number" 
                KeyDown="PersonnelNumberTextBox_KeyDown" 
                Width="200" 
                Grid.Row="0" 
                Grid.Column="0" 
                Grid.ColumnSpan="2" 
                Margin="0,0,0,5"/>

       <!-- Buttons with aligned grid positions and 10px space -->
       <Button x:Name="SignInButton" 
               Content="Sign In" 
               Click="signInButton_Click"  
               Style="{StaticResource AccentButtonStyle}" 
               Grid.Row="2" 
               Grid.Column="0" 
               Width="95" 
               Margin="0,5,5,5"/>

       <Button x:Name="SignOutButton" 
               Content="Sign Out" 
               Click="signOutButton_Click"  
               Style="{StaticResource AccentButtonStyle}" 
               Grid.Row="2" 
               Grid.Column="1" 
               Width="95" 
               Margin="5,5,0,5"/>

       <!-- ConsoleOutput TextBox for display -->
       <TextBox x:Name="ConsoleOutput"
                FontFamily="Consolas"
                FontSize="14"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Grid.Row="4" 
                Grid.Column="0" 
                Grid.ColumnSpan="4" 
                Margin="0,5,0,5"
                Height="300"
                Width="Auto"
                VerticalAlignment="Top"/>

       <!-- New row for debug buttons -->
       <Button x:Name="DebugOneButton"
               Content="Debug One"
               Click="debugOneButton_Click"
               Background="LightSteelBlue"
               Grid.Row="5"
               Grid.Column="0"
               Margin="0,5,5,5"
               Width="95"/>

       <Button x:Name="DebugTwoButton"
               Content="Debug Two"
               Click="debugTwoButton_Click"
               Background="LightSteelBlue"
               Grid.Row="5"
               Grid.Column="1"
               Margin="5,5,0,5"
               Width="95"/>

       <Button x:Name="Task1Button"
               Content="Task One"
               Click="taskOneButton_Click"
               Background="LightSteelBlue"
               Grid.Row="6"
               Grid.Column="0"
               Margin="0,5,5,5"
               Width="95"/>

       <Button x:Name="Task2Button"
               Content="Task Two"
               Click="taskTwoButton_Click"
               Background="LightSteelBlue"
               Grid.Row="7"
               Grid.Column="0"
               Margin="0,5,5,5"
               Width="95"/>

       <Button x:Name="Task3Button"
               Content="Task Three"
               Click="taskThreeButton_Click"
               Background="LightSteelBlue"
               Grid.Row="8"
               Grid.Column="0"
               Margin="0,5,5,5"
               Width="95"/>

       <Button x:Name="Task4Button"
               Content="Task Four"
               Click="taskFourButton_Click"
               Background="LightSteelBlue"
               Grid.Row="9"
               Grid.Column="0"
               Margin="0,5,5,5"
               Width="95"/>

       <Button x:Name="Task5Button"
               Content="Task Five"
               Click="taskFiveButton_Click"
               Background="LightSteelBlue"
               Grid.Row="10"
               Grid.Column="0"
               Margin="0,5,5,5"
               Width="95"/>

       <Button x:Name="Task6Button"
               Content="Task Six"
               Click="taskSixButton_Click"
               Background="LightSteelBlue"
               Grid.Row="11"
               Grid.Column="0"
               Margin="0,5,5,5"
               Width="95"/>
    </Grid>
</Page>