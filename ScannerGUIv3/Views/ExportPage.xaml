<Page
    x:Class="ScannerGUIv3.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  
  <Border BorderBrush="Gray" BorderThickness="1">
   <Grid Margin="20">
      
      <StackPanel x:Name="ContentArea">
        
        <StackPanel Margin="{StaticResource SmallTopBottomMargin}">
          
          <TextBlock x:Uid="Export_Header"  Style="{ThemeResource SubtitleTextBlockStyle}" />
          
          <TextBlock Text="Email Address:" Margin="{StaticResource XSmallTopMargin}" />
          <TextBox x:Name="EmailAddressTextBox"
                   PlaceholderText="example@domain.com"
                   Width="200"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Left" />

          <RadioButtons x:Name="ExportOptionsGroup">
            <RadioButton Content="Email" />
            <RadioButton Content="Teams" />
            <RadioButton Content="File" />
          </RadioButtons>

          <Button x:Name="exportButton"
                  Content="Export"
                  Click="exportButton_Click"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Left"/>

          <Button x:Name="testButton"
                  Content="Test"
                  Click="testButton_Click"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Left"/>

        </StackPanel>
        
      </StackPanel>
      
    </Grid>
  </Border>
</Page>
